version: 1
kind: language
language: zh-CN
sourcelanguage: en

[App]
ready:
  src: Ready
  tr: 就绪

[AppNoBridge]
caption:
  src: panta — Minimal Shell (Bridge disabled)
  tr: panta — 最小 Shell（Bridge 已关闭）

[PlaceholderPanel]
placeholder:
  src: Panel placeholder: project tree / viewport / properties (upcoming tasks)
  tr: 面板占位：工程树 / 视口 / 属性区（后续任务）

[RibbonPanel]
start:
  src: Start
  tr: 启动

whats-new:
  src: New
  tr: 新功能

learning:
  src: Learning
  tr: 学习

[TasksPanel]
tab-tools:
  src: Tools
  tr: 工具

tab-tasks:
  src: Task List
  tr: 任务

tab-shared-views:
  src: Shared Views
  tr: 共享视图

new-project:
  src: New Project
  tr: 新建工程

[NewProjectDialog]
title:
  src: Create New Project
  tr: 新建工程

description:
  src: Create a project directory and start with an empty workspace.
  tr: 创建工程目录并开始一个空工作区。

project-name:
  src: Project name
  tr: 工程名称

placeholder-name:
  src: My Project
  tr: 我的工程

create-in:
  src: Create in
  tr: 创建位置

placeholder-folder:
  src: Choose a folder
  tr: 选择文件夹

project-location:
  src: Project location
  tr: 工程位置

browse:
  src: Browse
  tr: 浏览

folder-note:
  src: The project folder and .panta file will be created if they do not already exist.
  tr: 如果工程文件夹和 .panta 文件不存在，将自动创建。

choose-location:
  src: Choose Project Location
  tr: 选择工程位置

error-name:
  src: Enter a valid project name.
  tr: 请输入有效的工程名称。

error-location:
  src: Choose an absolute project location.
  tr: 请选择绝对工程路径。

error-location-create:
  src: The project location could not be created.
  tr: 无法创建工程位置。

error-root:
  src: The selected project cannot be found.
  tr: 找不到所选工程。

error-exists:
  src: A project with this name already exists.
  tr: 同名工程已经存在。

error-manifest:
  src: The selected folder is not a supported panta project.
  tr: 所选文件夹不是受支持的 panta 工程。

error-no-project:
  src: Open or create a project first.
  tr: 请先打开或创建工程。

error-command:
  src: The project change is not valid.
  tr: 工程修改无效。

error-generic:
  src: The project operation could not be completed.
  tr: 工程操作无法完成。

[IconActionOpenProject]
label:
  src: Open Project
  tr: 打开工程

[ProjectFileDialog]
filter:
  src: Panta project files (*.panta)
  tr: Panta 工程文件 (*.panta)

[TopChromePanel]
menu-view:
  src: View
  tr: 查看

