  tr: Choose Project Location

error-name:
  src: Enter a valid project name.
  tr: Enter a valid project name.

error-location:
  src: Choose an absolute project location.
  tr: Choose an absolute project location.

error-location-create:
  src: The project location could not be created.
  tr: The project location could not be created.

error-root:
  src: The selected project cannot be found.
  tr: The selected project cannot be found.

error-exists:
  src: A project with this name already exists.
  tr: A project with this name already exists.

error-manifest:
  src: The selected folder is not a supported panta project.
  tr: The selected folder is not a supported panta project.

error-no-project:
  src: Open or create a project first.
  tr: Open or create a project first.

error-command:
  src: The project change is not valid.
  tr: The project change is not valid.

error-generic:
  src: The project operation could not be completed.
  tr: The project operation could not be completed.

