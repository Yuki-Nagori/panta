#!/bin/sh
# 提交前质量门禁：聚合检查、格式与 Rust lint 必须通过，否则拒绝提交。
# 聚合检查与 CI 的 rust job 使用同一条 cargo check 命令。
# 启用方式（每台机器一次性，git 不随仓库携带 hooks 配置）：
#   git config core.hooksPath .githooks
set -e

echo "[pre-commit] cargo check --locked --workspace --all-targets"
cargo check --locked --workspace --all-targets

echo "[pre-commit] cargo format"
cargo format

echo "[pre-commit] cargo lint clippy"
cargo lint clippy

echo "[pre-commit] 通过"
