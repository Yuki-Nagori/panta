#!/bin/sh
# 提交前质量门禁：格式与 Rust lint 必须通过，否则拒绝提交。
# 不重复执行 cargo check；Clippy 仍会运行 build.rs，可能触发 native 构建。
# 启用方式（每台机器一次性，git 不随仓库携带 hooks 配置）：
#   git config core.hooksPath .githooks
set -e

echo "[pre-commit] cargo format"
cargo format

echo "[pre-commit] cargo lint clippy"
cargo lint clippy

echo "[pre-commit] 通过"
