Checks: >-
  -*,
  clang-analyzer-*,
  bugprone-*,
  performance-*
WarningsAsErrors: '*'
HeaderFilterRegex: '(^|/)(native|tests/(cpp|qml)|crates/panta-ffi)/'
# target 中的 Qt/CXX 生成头属于构建输入，不对其应用自有代码告警。
ExcludeHeaderFilterRegex: '(^|/)target/'
FormatStyle: file

CheckOptions:
  # IgnoreHeaders 为后缀匹配语义（每条正则匹配头文件路径的后缀，`;` 分隔），
  # 直接列文件名即可。include-cleaner 不追踪宏内部依赖，也不理解"聚合头/
  # 契约头"的框架与上游约定，下列头按来源分类豁免删除与缺失插入：
  # - Qt 框架头：QtGlobal 转发 qglobal 系聚合头；QTRY_* 依赖 qtest.h 宏内部。
  # - netgen 契约头：mystdlib.h 提供 `using namespace std`（ngarray/table 等
  #   遗留头的硬前提），其作用不可被追踪，禁止清理器删除或告警。
  misc-include-cleaner.IgnoreHeaders: 'QtGlobal;qglobal\.h;qtypes\.h;qminmax\.h;qnumeric\.h;qstringliteral\.h;qtest\.h;mystdlib\.h'
