Checks: >-
  -*,
  clang-analyzer-*,
  bugprone-*,
  performance-*
WarningsAsErrors: '*'
HeaderFilterRegex: '(^|/)(native|tests/(cpp|qml)|crates/panta-ffi)/'
# target 中的 Qt/CXX 生成头属于构建输入，不对其应用自有代码告警。
ExcludeHeaderFilterRegex: '(^|/)target/'
FormatStyle: file

CheckOptions:
  # QtGlobal 转发 qglobal.h/qtypes.h/qminmax.h/qnumeric.h，QStringLiteral 的声明也可能经 QtCore 聚合头可见；
  # Qt 基础头是框架约定，不应为满足 include-cleaner 改成标准库替代品。
  # QTRY_* 依赖 qtest.h 的宏内部声明，include-cleaner 同样不追踪宏内部依赖。
  misc-include-cleaner.IgnoreHeaders: '(^|/)(QtGlobal|qglobal\.h|qtypes\.h|qminmax\.h|qnumeric\.h|qstringliteral\.h|QtTest/qtest\.h|QtTest.framework/Headers/qtest\.h)$'
